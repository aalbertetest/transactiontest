# 03 — Arithmetic operators
let a = 17
let b = 5

println("a + b =", a + b)
println("a - b =", a - b)
println("a * b =", a * b)
println("a / b =", a / b)   # integer floor division: 17 // 5 = 3
println("a % b =", a % b)
println("a ** b =", a ** b)

# Floating-point math
let x = 2.5
let y = 4.0
println("sqrt(y) =", sqrt(y))
println("floor(x) =", floor(x))
println("ceil(x) =", ceil(x))
println("round(x) =", round(x))
println("abs(-7) =", abs(-7))
