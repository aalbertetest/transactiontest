# 02 — Variables and types
let name = "Sprout"
let version = 1
let pi = 3.14159
let active = true
let nothing = nil

println("Name:   ", name)
println("Version:", version)
println("Pi:     ", pi)
println("Active: ", active)
println("Nothing:", nothing)

# Type inspection
println(type(name))
println(type(version))
println(type(pi))
println(type(active))
println(type(nothing))
