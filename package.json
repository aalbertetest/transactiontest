{
  "name": "legacy-node-refactor-demo",
  "version": "1.0.0",
  "description": "A deliberately messy Node.js order API refactored into a typed, tested architecture.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "legacy": "node legacy/before/app.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "node",
    "typescript",
    "refactor",
    "legacy"
  ],
  "license": "MIT"
}
