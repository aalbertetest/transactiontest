{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebhookEvent",
  "type": "object",
  "required": ["id", "type", "created_at", "data"],
  "properties": {
    "id": {"type": "string"},
    "type": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "data": {
      "type": "object",
      "properties": {
        "object": {"type": "string"},
        "id": {"type": "string"},
        "attributes": {"type": "object"}
      },
      "required": ["object", "id", "attributes"]
    }
  }
}
